<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projeto_forms_Vet.Views.FormViewPet"
             Title="Pets">
    <VerticalStackLayout Padding="30" Spacing="25"  HorizontalOptions="Center">
        <Label 
            Text="Pets cadastrados no sistema"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label Text="Pesquisar:"/>
        <Entry x:Name="Pesquisa"
               Placeholder="Pesquisar Pet"
               HorizontalOptions="Fill"
               Keyboard="Default"/>


        <HorizontalStackLayout Spacing="20">
            <Button x:Name="Cadastrar"
                 Text="Novo"
                 WidthRequest="200"
                 HorizontalOptions="Start"
                 Background="Green"
                 Clicked="onNovoPet"/>      
            <Button Text="Voltar" Clicked="OnVoltarClicked" BackgroundColor="Gray" WidthRequest="200"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>