<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projeto_forms_Vet.Views.FormPet"
             Title="Form PET">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="ID:" />
            <Entry x:Name="txtId" Placeholder="Ex: 1" Keyboard="Numeric" />

            <Label Text="Nome:" />
            <Entry x:Name="txtNome" Placeholder="Nome do pet" />

            <Label Text="Espécie:" />
            <Picker x:Name="pckEspecie" Title="Selecione a espécie">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Cachorro</x:String>
                        <x:String>Gato</x:String>
                        <x:String>Pássaro</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Raça:" />
            <Picker x:Name="pckRaca" Title="Selecione a raça" />

            <Label Text="Peso:" />
            <Entry x:Name="txtPeso" Placeholder="Ex: 5.5" Keyboard="Numeric" />

            <Label Text="Nasc:" />
            <DatePicker x:Name="dtpNascimento" DateSelected="OnDataNascimentoSelected" />

            <Label Text="Idade: Calcula" x:Name="lblIdade" FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center" Margin="0,20,0,0">
                <Button Text="Voltar" Clicked="OnVoltarClicked" BackgroundColor="Gray" WidthRequest="100"/>
                <Button Text="SALVAR" BackgroundColor="Green" WidthRequest="100" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>