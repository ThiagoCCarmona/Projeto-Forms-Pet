<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Projeto_forms_Vet.Views.FormCadastro"
             Title="Cadastro de usuário">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25"  HorizontalOptions="Center">
            <Label 
                    Text="Cadastro de novo uusário"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" />

            <Label Text="Nome:" />
            <Entry x:Name="txtNome"
                    Placeholder="Nome" 
                    Keyboard="Text"/>

            <Label Text="CPF:" />
            <Entry x:Name="txtCPF"
                    Placeholder="Insira o CPF"
                    Keyboard="Numeric"/>

            <Label Text="E-mail:" />
            <Entry x:Name="txtEmail"
                    Placeholder="E-mail" 
                    Keyboard="Email"/>

            <Label Text="Senha"/>
            <Entry x:Name="Senha" 
                    Placeholder="Senha" 
                    Keyboard="Password" 
                    HorizontalOptions="Fill"/>

            <Label Text="Confirme a senha:"/>
            <Entry x:Name="SenhaConfirmacao" 
                    Placeholder="Senha" 
                    Keyboard="Password" 
                    HorizontalOptions="Fill"/>


            <Label Text="Telefone:" />
            <Entry x:Name="txtTelefone"
                    Placeholder="Telefone"
                    Keyboard="Telephone"/>

            <Label Text="Data de Nascimento:" />
            <DatePicker x:Name="txtDataNascimento"/>

            <HorizontalStackLayout Spacing="10">
                <Label Text="Selecione um endereço:"/>
                <Button Text="Procurar endereço" 
                        HorizontalOptions="Fill"
                        Clicked="onClickedProcurarEndereco"/>
            </HorizontalStackLayout>
            
            <HorizontalStackLayout  Spacing="20" HorizontalOptions="Center">
                    <Button x:Name="Cadastrar"
                            Text="Novo"
                            WidthRequest="200"
                            HorizontalOptions="Start"
                            Background="Green"
                            Clicked="onClickedSalvaCadastro"/>      
                    <Button Text="Voltar" Clicked="OnVoltarClicked" BackgroundColor="Gray" WidthRequest="200"/>
             </HorizontalStackLayout>

        </VerticalStackLayout>



    </ScrollView>
    
</ContentPage>